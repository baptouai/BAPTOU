rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // The app may only write these fields. Subscription, usage, Gmail and mail-index state are written
      // by the server (so nobody can grant themselves a plan from the browser).
      function appFields() {
        return ['email', 'displayName', 'lastSeenAt', 'nationalities', 'favouriteContacts'];
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(appFields());
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(appFields());

      match /documents/{docId} {
        allow read, write: if isOwner(uid);
      }

      // People from the mailbox to contact, with draft emails. Created by findContacts; the user can
      // edit drafts or dismiss, but only the server records a send.
      match /contacts/{contactId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.status != 'sent'
          && request.resource.data.get('sentAt', null) == resource.data.get('sentAt', null);
      }

      // Correspondents index built from email headers by the server (no AI). Read-only for the owner.
      match /mailIndex/{entryId} {
        allow read: if isOwner(uid);
      }

      // Replies to applications found in the mailbox (written by the server). The app only marks them seen.
      match /replies/{replyId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      }

      // Offers the user turned down (the offer itself is deleted). Written by dismissOffer only.
      match /dismissedOffers/{offerId} {
        allow read: if isOwner(uid);
      }

      // Internship searches: BAPTOU only searches while one is "active".
      match /searches/{searchId} {
        allow read, write: if isOwner(uid);
      }

      match /applications/{appId} {
        allow read, delete: if isOwner(uid);
        // Only the server may record that an email was actually sent.
        allow create: if isOwner(uid) && !('emailSentAt' in request.resource.data);
        allow update: if isOwner(uid)
          && request.resource.data.get('emailSentAt', null) == resource.data.get('emailSentAt', null);

        match /letterVersions/{versionId} {
          allow read, create: if isOwner(uid);
        }

        // "Is this for me?" conversation, written by the askAboutOffer function only.
        match /chat/{messageId} {
          allow read: if isOwner(uid);
        }
      }
    }

    // Invite list (email -> optional monthly limit), managed by the owner in the console. Server-only.
    match /access/{email} {
      allow read, write: if false;
    }

    // Server-only: Gmail tokens, usage counters, subscription status.
    match /private/{uid} {
      allow read, write: if false;
    }
  }
}
