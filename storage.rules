rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed in, with a confirmed email address (as in firestore.rules).
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    // The student's signature, placed at the bottom of their letters: a small PNG or JPEG.
    match /users/{uid}/signature/{file} {
      allow write: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg)');
    }
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/(msword|vnd.openxmlformats-officedocument.wordprocessingml.document)'));
    }
  }
}
